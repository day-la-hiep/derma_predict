# Sao chép thành .env rồi chỉnh. Mặc định khớp docker-compose.yml ở gốc repo và app/config/settings.py,
# nên dev chỉ cần điền API key (mục 3). Sửa xong phải khởi động lại `make backend` và `make worker`.
# Không commit .env thật, không dán key vào chat/issue.

# ===== 1. Chung =====
PROJECT_NAME=Derma AI Backend
DEBUG=false
LOG_LEVEL=INFO                      # DEBUG/INFO/WARNING/ERROR; NO_COLOR=1 tắt màu, FORCE_COLOR=1 ép bật
CORS_ORIGINS=["*"]                  # JSON array

# ===== 2. Hạ tầng =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/derma_hospital_db
# DATABASE_POOL_PRE_PING=true
# DATABASE_EXPIRE_ON_COMMIT=false
# DATABASE_AUTOFLUSH=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
AGENT_TURN_KEY_TTL=60               # TTL (giây) của Redis key agent:pending_turn:* / agent:active_turn:*

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=derma_qdrant_2026    # khớp QDRANT__SERVICE__API_KEY trong docker-compose.yml; trống nếu không bật auth
QDRANT_LEGACY_BOOK_COLLECTION=derma_book_chunks   # collection sách cũ (chỉ semantic); trống nếu không còn

NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=derma12345

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=derma-attachments      # ảnh đính kèm tin nhắn
MINIO_SECURE=false

# ===== 3. API key (chỉ điền key của provider bạn dùng ở mục 4) =====
# Tiền tố "provider:" của chuỗi model quyết định cần key nào. Điền thẳng sau dấu "=", không nháy, không dấu cách thừa.
#   openrouter:...    OPENROUTER_API_KEY   https://openrouter.ai/keys                  (cũng dùng cho embedding + reranker, cần cho tra cứu sách)
#   openai:...        OPENAI_API_KEY       https://platform.openai.com/api-keys       (OpenAI trực tiếp, khác OpenRouter)
#   deepseek:...      DEEPSEEK_API_KEY     https://platform.deepseek.com/api_keys     (key riêng, không dùng chung OpenRouter)
#   google_genai:...  GOOGLE_API_KEY       https://aistudio.google.com/apikey
#   local:...         không cần key thật   (Ollama/vLLM, xem LOCAL_LLM_* ở mục 4)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# Tra web: https://app.tavily.com ; trống = tool tra web tắt
TAVILY_API_KEY=

# ===== 4. Model của agent: dạng "provider:model", đi qua agent/common/llm.py::get_model =====
# Provider: openrouter | openai | google_genai (Gemini) | deepseek | local (Ollama/vLLM, OpenAI-compatible).
AGENT_MODEL=openrouter:google/gemma-4-26b-a4b-it   # luồng chính; mỗi hội thoại chọn trong AGENT_MODEL_CHOICES (settings.py)
AGENT_TEMPERATURE=0.3
AGENT_THINKING_LEVEL=medium         # chỉ áp dụng cho google_genai
AGENT_TRIAGE_ENABLED=true           # bước lọc intent (chào hỏi / ngoài phạm vi thì trả lời luôn)
# Trống = dùng model của hội thoại; vd local:gemma3:4b
AGENT_TRIAGE_MODEL=
# AGENT_VISION_MODEL=local:medgemma:4b   # tool mô tả ảnh (multimodal); trống = tắt, agent chỉ dùng CNN. Ảnh gửi tới provider này
# AGENT_VISION_TIMEOUT=120

# Server local: Ollama mặc định :11434/v1, vLLM thường :8000/v1.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_TIMEOUT=300

# ===== 5. Tool ảnh =====
# SKIN_CNN_CHECKPOINT_PATH=         # mặc định ../model/model_output/AdaptiveCNN_SkinDisease_v5_best.pth

# ===== 6. LangSmith (trace LLM/tool; false = tắt hoàn toàn) =====
LANGSMITH_TRACING=false
# Key: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=derma-hospital
# LANGSMITH_ENDPOINT=               # chỉ khi dùng LangSmith self-hosted/proxy
