// Derma Hospital — schema PostgreSQL hiện tại
// Nguồn: core/app/models/*.py, khớp migration head 3e4b8f67b9ca (2026-10-05).
// Xem trên https://dbdiagram.io (dán nội dung file này).
// Đã gộp thiết kế mới (tmp/plan/2026-11-03-de-xuat-schema.html, hướng đợt bệnh) — CHƯA có migration.
// Cột / bảng đề xuất đánh dấu "[Pn]" theo giai đoạn trong tmp/plan/todo; bảng mới có header cam.
// id dạng chuỗi do DB sinh (gen_random_uuid()); dữ liệu cũ có thể còn id dạng `conv-<uuid>`, `msg-<uuid>`.

Project derma_hospital {
  database_type: 'PostgreSQL'
  Note: 'File lớn (PDF, ảnh, pages.jsonl, chunk...) nằm ở MinIO; bảng `files` chỉ giữ metadata + storage_key. Vector nằm ở Qdrant, KG ở Neo4j.'
}

// ===================== Người dùng =====================

TableGroup nguoi_dung {
  users
  patient_profiles
  doctors
  admins
}

Table users {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  username varchar(64) [unique, not null]
  full_name varchar(255) [not null]
  dob date [not null]
  gender varchar(16) [not null, note: 'male | female']
  password_hash varchar(255) [null, note: 'null: tài khoản mẫu chưa đặt mật khẩu']
  created_at timestamptz [not null]
  Note: 'Tài khoản. Có cột mật khẩu; đăng ký / đăng nhập qua `/auth/*` (JWT).'
}

Table patient_profiles {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  user_id varchar(64) [not null, ref: > users.id]
  full_name varchar(255) [not null]
  dob date [not null]
  gender varchar(16) [not null, note: 'male | female']
  relationship varchar(16) [not null, default: 'self', note: 'self | child | parent | spouse | other']
  phone varchar(32) [null]
  allergies text [not null, default: '', note: 'tự khai. [Đợt 3] backfill thành fact allergy dài hạn rồi BỎ CỘT']
  medical_history text [not null, default: '', note: 'tự khai. [Đợt 3] backfill thành fact history dài hạn rồi BỎ CỘT']
  created_at timestamptz [not null]
  Indexes {
    user_id
  }
  Note: 'Một tài khoản có nhiều hồ sơ bệnh nhân (bản thân, người nhà). ON DELETE CASCADE theo users.'
}

Table doctors {
  user_id varchar(64) [pk, ref: - users.id]
  description text [not null, note: 'giới thiệu chuyên môn']
  Note: 'Vai trò bác sĩ (1-1 với users). ON DELETE CASCADE.'
}

Table admins {
  user_id varchar(64) [pk, ref: - users.id]
  Note: 'Vai trò quản trị (1-1 với users). ON DELETE CASCADE.'
}

// ===================== Hội thoại & tư vấn =====================

TableGroup hoi_thoai {
  conversations
  messages
  message_files
  consultation_sessions
  video_calls
}

Table conversations {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  title varchar(255) [not null, default: '']
  model varchar(32) [not null, note: 'id ngắn trong AGENT_MODEL_CHOICES, không phải chuỗi provider:model']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Một hội thoại thuộc một hồ sơ bệnh nhân; chủ tài khoản = patient_profiles.user_id.'
}

Table messages {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  conversation_id varchar(64) [not null, ref: > conversations.id]
  sender varchar(20) [not null, note: 'patient | ai | doctor']
  message_type varchar(32) [not null, default: 'text', note: 'text | attached | video_call | consultation_requested | consultation_accepted | consultation_resolved']
  video_call_id varchar(64) [null, note: 'chỉ với message_type = video_call']
  consultation_session_id varchar(64) [null, note: 'chỉ với 3 tin mốc consultation_*']
  content text [not null, default: '']
  status varchar(20) [not null, note: 'queued | done | question (còn khai báo pending | streaming)']
  metadata jsonb [null, note: 'ORM attribute `extra`. Tin AI: reasoning[], choice, sources[]. Tin user: attached_files, is_option_response']
  created_at timestamptz [not null]
  Indexes {
    consultation_session_id
  }
}

Table message_files {
  message_id varchar(64) [pk, ref: > messages.id]
  file_id varchar(64) [pk, ref: > files.id]
  Note: 'Ảnh / tệp đính kèm của tin nhắn (n-n). ON DELETE CASCADE cả hai phía.'
}

Table consultation_sessions {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  conversation_id varchar(64) [not null, ref: > conversations.id]
  doctor_id varchar(64) [null, ref: > doctors.user_id, note: 'null khi chưa có bác sĩ nhận']
  status varchar(16) [not null, default: 'pending', note: 'pending | active | resolved']
  reason text [not null]
  requested_at timestamptz [not null]
  started_at timestamptz [null]
  resolved_at timestamptz [null]
  Indexes {
    conversation_id
    conversation_id [unique, name: 'uq_consultation_sessions_open_per_conversation', note: "partial: WHERE status <> 'resolved' — tối đa 1 phiên mở / hội thoại"]
  }
  Note: '''
  Phiên tư vấn bác sĩ trong một hội thoại.
  [P3] Luồng mới không tạo phiên (thay bằng appointments → encounters); giữ cho dữ liệu cũ + video call.
  CHECK doctor_when_not_pending: status = 'pending' OR doctor_id IS NOT NULL
  CHECK resolved_at_when_resolved: status <> 'resolved' OR resolved_at IS NOT NULL
  conversation_id ON DELETE CASCADE, doctor_id ON DELETE SET NULL.
  '''
}

Table video_calls {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  consultation_session_id varchar(64) [not null, ref: > consultation_sessions.id, note: 'phiên tư vấn chứa cuộc gọi']
  room_id varchar(128) [unique, not null]
  status varchar(16) [not null, default: 'pending', note: 'pending | ongoing | ended']
  started_at timestamptz [null]
  ended_at timestamptz [null]
  created_at timestamptz [not null]
  Indexes {
    consultation_session_id
  }
  Note: 'Cuộc gọi video thuộc một phiên tư vấn (1 phiên nhiều cuộc gọi); hiện thành tin trong luồng chat qua messages.video_call_id (mới có schema). ON DELETE CASCADE theo consultation_sessions.'
}

// ===================== Báo cáo kết luận =====================

TableGroup benh_an {
  finalize_reports
  patient_images
}

Table finalize_reports {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  doctor_id varchar(64) [null, ref: > doctors.user_id, note: 'bác sĩ ghi báo cáo kết luận']
  diagnosis text [not null]
  notes text [not null, default: '']
  is_reference_case boolean [not null, default: false, note: 'ca bệnh tham khảo — dùng cho KB / tra ca tương tự']
  consultation_session_id varchar(64) [null, unique, ref: > consultation_sessions.id, note: '1 báo cáo / phiên tư vấn — chỉ dữ liệu cũ']
  encounter_id varchar(64) [null, unique, ref: - encounters.id, note: '[P5] 1 kết luận / lần khám; NULL = dữ liệu cũ']
  diagnosis_code varchar(64) [null, note: '[P5] lớp CNN | OTHER (danh mục là hằng trong code)']
  snapshot jsonb [null, note: 'bản chụp bất biến lúc chốt; [P5] chép fact dài hạn + fact của đợt, thêm removed_facts']
  created_at timestamptz [not null]
  Indexes {
    patient_profile_id
  }
  Note: '''
  Kết luận bác sĩ chốt. Cũ: từ phiên tư vấn; mới [P5]: từ lần khám trực tiếp. Là lịch sử bất biến; graph Neo4j chỉ nạp từ đây.
  [P5] CHECK code_when_encounter: encounter_id IS NULL OR diagnosis_code IS NOT NULL
  patient_profile_id ON DELETE CASCADE; doctor_id ON DELETE SET NULL.
  '''
}

Table patient_images {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  finalize_report_id varchar(64) [not null, ref: > finalize_reports.id]
  file_id varchar(64) [not null, ref: > files.id, note: 'có thể dùng lại file bệnh nhân đã gửi trong chat']
  body_site varchar(128) [not null, default: '', note: 'vị trí trên cơ thể']
  description text [not null, default: '']
  confirmed_label varchar(128) [null, note: 'nhãn bác sĩ xác nhận — dữ liệu huấn luyện CNN']
  captured_at timestamptz [null]
  Indexes {
    finalize_report_id
  }
  Note: 'Ảnh bệnh do bác sĩ gắn vào báo cáo kết luận. ON DELETE CASCADE theo finalize_reports và files.'
}

// ===================== Clinical fact & báo cáo tiền tư vấn =====================

TableGroup lam_sang {
  clinical_facts
  clinical_provenances
  clinical_episodes
  ai_hypotheses
}

// [P1] clinical_fact_templates: BỎ — fact_type/label/ontology_id chép sang clinical_facts rồi drop (template sinh tự do, không phải danh mục).
// Danh mục do bác sĩ cấu hình: docs/pending/fact-template-catalog.md
// [P2] pre_consultation_reports: BỎ — mỗi báo cáo cũ → 1 clinical_episodes closed (vùng nhieu_vung, summary), rồi drop.

Table clinical_facts {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  episode_id varchar(64) [null, ref: > clinical_episodes.id, note: '[P1] NULL = fact dài hạn (allergy | history | medication); khác NULL = fact theo đợt. ON DELETE CASCADE']
  fact_type varchar(32) [not null, note: '[P1] từ template. symptom | lesion | history | medication | allergy | other (bỏ image_finding)']
  label varchar(255) [not null, note: '[P1] từ template']
  ontology_id varchar(128) [null, note: '[P1] từ template; DermO / PrimeKG']
  detail text [not null, default: '', note: 'giá trị hiện tại — thay thế, không nối; ≤ 300 ký tự']
  verified_at timestamptz [null, note: '[P1] bác sĩ xác nhận lúc chốt; AI sửa lại → NULL']
  verified_by_id varchar(64) [null, ref: > doctors.user_id, note: '[P1] ON DELETE SET NULL']
  created_at timestamptz [not null]
  updated_at timestamptz [not null, note: '[P1]']
  Indexes {
    patient_profile_id
    episode_id
  }
  Note: '''
  [P1] TÌNH TRẠNG HIỆN TẠI, sửa tại chỗ. Bỏ template_id, status, superseded_by_id.
  Lịch sử: nhật ký clinical_provenances + snapshot của finalize_reports.
  AI ghi khi chat (chưa xác nhận), không được xoá; bác sĩ sửa / thêm / xoá lúc chốt.
  CHECK long_term_no_episode: (fact_type IN ('allergy','history','medication')) = (episode_id IS NULL)
  UNIQUE uq_clinical_facts_long_term: (patient_profile_id, fact_type, lower(label)) WHERE episode_id IS NULL
  UNIQUE uq_clinical_facts_episode: (episode_id, fact_type, lower(label)) WHERE episode_id IS NOT NULL
  Migration: gộp fact trùng khoá (giữ bản mới nhất, dồn nhật ký); symptom/lesion/other cũ gắn vào đợt closed "dữ liệu cũ"; image_finding cũ → other.
  ON DELETE CASCADE theo patient_profiles.
  '''
}

Table clinical_provenances {
  id varchar(64) [pk, default: `gen_random_uuid()`, note: '[P1] thay PK ghép (fact_id, message_id)']
  fact_id varchar(64) [not null, ref: > clinical_facts.id]
  kind varchar(16) [not null, default: 'chat', note: '[P1] chat | doctor; dữ liệu cũ = chat']
  message_id varchar(64) [null, note: 'tin gốc (kind = chat). [P1] đổi CASCADE → SET NULL']
  quote text [not null, default: '', note: '[P1] trích tin gốc; backfill từ messages.content']
  encounter_id varchar(64) [null, ref: > encounters.id, note: '[P4] kind = doctor']
  doctor_id varchar(64) [null, ref: > doctors.user_id, note: '[P1] kind = doctor']
  detail text [not null, default: '', note: '[P1] giá trị fact nguồn này ghi nhận; backfill = detail hiện tại']
  created_at timestamptz [not null, note: '[P1] backfill = messages.created_at']
  Indexes {
    fact_id
    message_id
  }
  Note: '''
  [P1] NHẬT KÝ CHỈ THÊM: bằng chứng + lịch sử thay đổi của fact.
  Chỉ thêm dòng khi detail đổi hoặc nguồn đầu tiên của một hội thoại. Không đưa vào prompt.
  CHECK kind_valid: kind IN ('chat', 'doctor'). fact_id ON DELETE CASCADE.
  '''
}

Table clinical_episodes [headercolor: #E67E22] {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  body_site varchar(16) [not null, note: 'dau_mat | da_dau_toc | co | than_truoc | lung | tay | ban_tay | chan | ban_chan | sinh_duc | mong | nhieu_vung']
  status varchar(16) [not null, default: 'open', note: 'open | in_exam | closed | expired']
  last_conversation_id varchar(64) [null, ref: > conversations.id, note: 'hội thoại cập nhật gần nhất; ON DELETE SET NULL']
  summary text [not null, default: '', note: 'báo cáo trước khám; sinh lúc đặt lịch, sinh lại khi bác sĩ mở mà dữ liệu đã đổi']
  summary_at timestamptz [null]
  urgency varchar(16) [null]
  red_flags jsonb [not null, default: `'[]'`]
  image_predictions jsonb [not null, default: `'[]'`, note: '[{file_id, top_k:[{label, score}]}] — thay fact image_finding']
  model_version varchar(64) [not null, default: '']
  opened_at timestamptz [not null]
  updated_at timestamptz [not null, note: 'căn cứ hết hạn 30 ngày']
  closed_at timestamptz [null]
  Indexes {
    (patient_profile_id, body_site) [unique, name: 'uq_clinical_episodes_active', note: "partial: WHERE status IN ('open','in_exam') — mỗi vùng tối đa 1 đợt đang hoạt động"]
  }
  Note: '''
  [P2] ĐỢT BỆNH = (hồ sơ, vùng, đợt): chứa giả thuyết AI, fact theo đợt, báo cáo trước khám; lịch hẹn nối vào.
  open → in_exam (bắt đầu khám, khoá giả thuyết) → closed (chốt kết luận).
  open → expired: 30 ngày không cập nhật và không gắn lịch hẹn đang hoạt động (kiểm tra lúc ghi).
  CHECK closed_at_when_closed: status IN ('open','in_exam') OR closed_at IS NOT NULL
  ON DELETE CASCADE theo patient_profiles.
  '''
}

Table ai_hypotheses [headercolor: #E67E22] {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  episode_id varchar(64) [not null, ref: > clinical_episodes.id]
  rank int [not null]
  diagnosis_code varchar(64) [not null, note: 'LLM chọn trong danh mục: 22 lớp CNN | OTHER']
  disease varchar(255) [not null, note: 'tên hiển thị (ReflectHypothesis.disease)']
  confidence varchar(8) [not null, note: 'cao | vừa | thấp']
  evidence jsonb [not null, default: `'[]'`, note: 'bằng chứng đã giải mã từ cites E#']
  missing jsonb [not null, default: `'[]'`, note: 'điều còn thiếu để xác nhận / loại trừ']
  Indexes {
    (episode_id, rank) [unique]
  }
  Note: '''
  [P2] Giả thuyết xếp hạng của đợt, từ node reflect (graph v2). Đợt open: mỗi lượt thay toàn bộ; từ in_exam: chỉ đọc.
  Chỉ số so tự động diagnosis_code với finalize_reports.diagnosis_code (cùng OTHER không tính trúng). Không có cột bác sĩ chấm.
  CHECK rank >= 1. ON DELETE CASCADE.
  '''
}

// ===================== [P3–P4] Lịch hẹn & khám =====================

TableGroup kham {
  appointments
  encounters
}

Table appointments [headercolor: #E67E22] {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  episode_id varchar(64) [not null, ref: > clinical_episodes.id, note: 'đợt open, chưa quá hạn, có ≥ 1 giả thuyết (đủ thông tin) — không có thì không đặt được']
  doctor_id varchar(64) [null, ref: > doctors.user_id, note: 'null tới khi xác nhận']
  scheduled_at timestamptz [not null]
  status varchar(16) [not null, default: 'requested', note: 'requested | confirmed | in_progress | done | cancelled | no_show']
  reason text [not null, default: '']
  cancel_reason text [null]
  created_at timestamptz [not null]
  Indexes {
    patient_profile_id
    (doctor_id, scheduled_at)
    episode_id [unique, name: 'uq_appointments_active_episode', note: "partial: WHERE status IN ('requested','confirmed','in_progress')"]
  }
  Note: '''
  [P3] Lịch hẹn cho một đợt đã đủ thông tin; vùng lấy từ đợt. Không có khám vãng lai: mọi lần khám bắt đầu từ lịch hẹn.
  Trước "Bắt đầu khám" được đổi sang đợt open đủ thông tin khác của hồ sơ.
  CHECK cancel_reason_when_cancelled: status <> 'cancelled' OR cancel_reason IS NOT NULL
  CHECK doctor_when_confirmed: status IN ('requested','cancelled') OR doctor_id IS NOT NULL
  '''
}

Table encounters [headercolor: #E67E22] {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  appointment_id varchar(64) [not null, unique, ref: - appointments.id, note: 'lần khám luôn từ lịch hẹn']
  patient_profile_id varchar(64) [not null, ref: > patient_profiles.id]
  doctor_id varchar(64) [null, ref: > doctors.user_id]
  status varchar(16) [not null, default: 'open', note: 'open | closed']
  opened_at timestamptz [not null]
  closed_at timestamptz [null]
  Note: '''
  [P4] Lần khám thật; tạo khi bác sĩ bấm "Bắt đầu khám" (cùng transaction: đợt → in_exam, lịch hẹn → in_progress).
  CHECK closed_at_when_closed: status <> 'closed' OR closed_at IS NOT NULL
  '''
}

// lab_orders, prescriptions, finalize_reports.diagnosis_certainty: HOÃN — docs/pending/lab-prescription.md

// ===================== File =====================

Table files {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  file_name varchar(255) [not null, note: 'tên hiển thị']
  storage_key varchar(512) [unique, not null, note: 'key object trong MinIO']
  content_type varchar(128) [null]
  size bigint [null, note: 'bytes']
  created_at timestamptz [not null]
  Note: 'Metadata file trong MinIO; dùng chung cho ảnh đính kèm tin nhắn và file của tài liệu.'
}

// ===================== Tài liệu (pipeline số hoá sách) =====================

TableGroup tai_lieu {
  documents
  document_stages
  document_overrides
}

Table documents {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  type varchar(16) [not null, default: 'book', note: 'book | image | video | other — hiện chỉ book đi qua pipeline']
  source_file_id varchar(64) [null, ref: > files.id, note: 'source.pdf']
  ingested_file_id varchar(64) [null, ref: > files.id, note: 'pages.jsonl (kết quả bước ingest)']
  pdf_pages int [null]
  profile jsonb [null, note: 'cấu hình xử lý (app/models/document_profile.py::Profile)']
  uploaded_by_id varchar(64) [null, ref: > doctors.user_id, note: 'bác sĩ tải lên (chỉ bác sĩ được tải); ON DELETE SET NULL']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'File của tài liệu nằm ở MinIO dưới document/<id>/. source_file_id, ingested_file_id ON DELETE SET NULL.'
}

Table document_stages {
  id varchar(64) [pk, default: `gen_random_uuid()`]
  document_id varchar(64) [not null, ref: > documents.id]
  stage_id varchar(32) [not null, note: 'ingest | toc | chunks | index']
  state varchar(32) [not null, default: 'not_started', note: 'not_started | running | pending_review | approved | failed | cancelled | stale']
  options jsonb [null, note: 'tham số lần chạy']
  progress jsonb [null]
  summary jsonb [null, note: 'tóm tắt kết quả hiển thị cho người duyệt']
  error text [null]
  started_at timestamptz [null]
  finished_at timestamptz [null]
  approved_at timestamptz [null]
  Indexes {
    (document_id, stage_id) [unique]
  }
  Note: 'Trạng thái từng bước của một tài liệu (4 dòng / tài liệu) — entity `Document.stages`. ON DELETE CASCADE.'
}

Table document_overrides {
  document_stage_id varchar(64) [pk, ref: - document_stages.id]
  data jsonb [not null, default: `'{}'`, note: 'sửa tay của người duyệt, ví dụ toc: {<id>: {...}, _deleted, _added, _offset}']
  updated_at timestamptz [not null]
  Note: 'Sửa tay tách khỏi kết quả máy để chạy lại bước không mất — entity `DocumentStage.overrides` (hiện tối đa 1 dòng / bước). ON DELETE CASCADE theo document_stages; tài liệu suy ra từ bước.'
}

// Hai FK của messages ghi riêng để thể hiện ON DELETE SET NULL
Ref: messages.video_call_id > video_calls.id [delete: set null]
Ref: messages.consultation_session_id > consultation_sessions.id [delete: set null]
Ref: clinical_provenances.message_id > messages.id [delete: set null]
